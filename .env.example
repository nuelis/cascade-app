# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OCR — pick ONE provider for extracting expiry dates from uploaded PDFs.
# AWS Textract is the most accurate for structured docs like insurance certs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Email alerts — Resend is the simplest to set up (resend.com)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Cron security — random string, checked by the cron endpoint so randoms
# on the internet can't trigger your expiration checks
CRON_SECRET=change-this-to-a-random-string
